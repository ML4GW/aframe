From: mambaorg/micromamba:2

%post
# create the environment from the project's lockfile
micromamba create -p /opt/env -f /opt/aframe/projects/@@PROJECT@@/@@PROJECT@@.conda-lock.yml

# install uv so we can install local deps of deps editably
micromamba run -p /opt/env python -m \
    pip install --no-build-isolation uv==0.9.30

# Export rather than `uv sync`, so that uv installs into the existing conda
# env instead of managing its own. Export to pylock.toml rather than
# requirements.txt so that the index each package was locked from is
# recorded. This allows torch to be installed from the PyTorch CPU index.
cd /opt/aframe
micromamba run -p /opt/env \
    @@UV_CMD@@ --no-cache -o pylock.toml

micromamba run -p /opt/env \
    uv pip install --no-cache -r pylock.toml

rm pylock.toml
micromamba clean -ay
