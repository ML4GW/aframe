# Environment variables consumed by the aframe pipeline.
# Copy to pipeline/.env (git-ignored), fill in, and `source` it before
# calling snakemake.

# --- HTCondor -----------------------------------------------------------------
# export LIGO_USERNAME=albert.einstein
# export LIGO_GROUP=ligo.dev.o4.cbc.allsky.aframe

# --- Containers ---------------------------------------------------------------
# Directory holding the images built by scripts/build_containers.py
# export AFRAME_CONTAINER_ROOT=${HOME}/aframe/images

# Optional: comma-separated extra directories to bind into every container,
# The run's own directories (run_dir, background_dir, waveforms_dir, log_dir) 
# are bound automatically.
# export AFRAME_DATA_DIRS=

# --- S3 (training on Nautilus; optional) --------------------------------------
# export AWS_ENDPOINT_URL=https://s3-west.nrp-nautilus.io
# export AWS_ACCESS_KEY_ID=
# export AWS_SECRET_ACCESS_KEY=

# --- Weights & Biases ---------------------------------------------------------
# Required when a WandbLogger is enabled in the train config
# export WANDB_API_KEY=
